# Where the SQLite database lives (created + seeded automatically on first run)
DATABASE_PATH=./data/kisahkisah.db
# Shared secret cinema partners use to sign purchase webhooks (HMAC-SHA256)
CINEMA_WEBHOOK_SECRET=change-me-in-production
# Comma-separated usernames that get admin access (item editor, partner inquiries)
ADMIN_USERNAMES=
# Where uploaded artwork is stored (swap src/lib/storage.ts for S3/R2 in production)
UPLOAD_DIR=./data/uploads
# Public URL, used in share links and link previews
NEXT_PUBLIC_SITE_URL=http://localhost:3000
