# Where the SQLite database lives (created + seeded automatically on first run)
DATABASE_PATH=./data/kisahkisah.db
# Shared secret cinema partners use to sign purchase webhooks (HMAC-SHA256)
CINEMA_WEBHOOK_SECRET=change-me-in-production
# Comma-separated usernames that get admin access (item editor, partner inquiries)
ADMIN_USERNAMES=
# Where uploaded artwork is stored (swap src/lib/storage.ts for S3/R2 in production)
UPLOAD_DIR=./data/uploads
# Public URL, used in share links and link previews
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Header your CDN uses for the visitor's country (Cloudflare, Vercel, CloudFront and common ones are tried by default)
GEO_HEADER=
# Salt for the daily-rotating visitor hash in event analytics (defaults to one derived from CINEMA_WEBHOOK_SECRET)
ANALYTICS_SALT=
# Email delivery through Resend (without these, mail goes to the dev outbox at /admin/outbox)
RESEND_API_KEY=
MAIL_FROM="KisahKisah <hello@example.com>"
# Set to 1 only behind a proxy you control, so X-Forwarded-For can be trusted for per-IP rate limits
TRUST_PROXY=
# TMDB v3 key or v4 read token: real posters, runtimes, cast, and adding missing titles from search
TMDB_API_KEY=
# Secret your scheduler sends to /api/cron (hourly) for release reminders and cleanup
CRON_SECRET=
# Seller details printed on order forms and invoices
BILLING_NAME=
BILLING_ADDRESS=
BILLING_TAX_ID=
BILLING_EMAIL=
BILLING_BANK=
# Artwork on S3-compatible storage (AWS S3, Cloudflare R2, MinIO). Leave STORAGE empty for local disk.
STORAGE=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Litestream backups (docker compose --profile backup)
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
# Two-step sign-in: key that encrypts authenticator secrets at rest (long random string)
TOTP_KEY=
# 1 = staff and admins must turn on two-step sign-in before using the admin
REQUIRE_STAFF_2FA=
# Reports from this many different members hide a review, comment or catalogue until staff review it
MOD_AUTO_HIDE=3
